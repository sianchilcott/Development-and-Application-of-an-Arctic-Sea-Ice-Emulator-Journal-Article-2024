%% ________ Step i: CMIP6 Arctic Amplification (AA) Parameterisation________ %%
% This section provides the function for the CMIP6 Arctic Amplification parameterisation outlined in Section 2.3.

% Initialisation 
rc_save = [];  % Save regression coefficients for CMIP6 AA parameterisation
AAT_emulation_anomaly = [];  % Save Arcitc annual mean temperature anomaly
AAT_emulation_absolute = []; % Save Arcitc annual mean temperature absolute
for n = 1:3
    for j = 1:12
        
        % CMIP6 Data
        rw = tas_global{n}{j};              % CMIP6 global mean surface air temperature
        raa = tas_arctic_annual{n}{j};      % CMIP6 Arctic annual mean surface air temperature

        
        % Calculate the Arctic annual temperature anomaly 
        AAT_emulation_anomaly{j,n} = rw .* rc_save{j,1};   % rc_save is given at the start of the script and is the AA factor for each model and is beta (ß) in the in-text paper. j is the index for each model.
        

        % Calculate the Arctic annual temperature absolute  
        CMIP6_AAT = mean(tas_store{n}{j}, 2);  % tas_store = absolute CMIP6 Arctic seasonal temperature dataset for all models used
        PI_cmip6 = mean(CMIP6_AAT(1:50)); % preindustrial temperature  
        AAT_emulation_absolute{j,n} = (rw .* rc_save{j,1}) + PI_cmip6;

    end
end




